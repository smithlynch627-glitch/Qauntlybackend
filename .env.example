# ───────────────────────── Server ─────────────────────────
NODE_ENV=production
PORT=8080
# Public https URL of this API (used for hosted images when IPFS is not configured)
API_PUBLIC_URL=https://your-api.up.railway.app
# Public marketplace site(s) allowed to call the API (add http://localhost:5173 for local dev)
CORS_ORIGINS=https://your-site.netlify.app
# The separate ADMIN site(s). Admin endpoints refuse every other origin (add http://localhost:5174 for local dev)
ADMIN_ORIGINS=https://admin-your-site.netlify.app
# 48 random bytes. PowerShell (cryptographically secure):
# $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
# 32 random bytes for AES-256-GCM. Same command with 32 instead of 48. NEVER change it after launch.
DATA_ENCRYPTION_KEY=
# Root admins (owner role, cannot be removed from the panel). Comma separated wallet addresses.
ADMIN_ADDRESSES=

# ───────────────────────── Database ───────────────────────
# Supabase → Connect → Session pooler. Use the least-privilege quantly_api role (db/02_api_role.sql):
DATABASE_URL=postgresql://quantly_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Optional but recommended: Supabase CA certificate (Settings → Database → SSL) to verify the server.
# Paste the PEM (with \n for new lines) or a file path.
DATABASE_CA_CERT=

# ───────── Network (locked to these values; the admin panel can't change them unless ALLOW_NETWORK_EDITS=1) ─────────
CHAIN_ID=19480
RPC_URL=https://rpc.testnet.qms.finance
PUBLIC_RPC_URL=https://rpc.testnet.qms.finance
EXPLORER_URL=https://testnet.qmsscan.io
EXPLORER_API_URL=https://testnet.qmsscan.io/api/v2
MARKET_ADDRESS=
LAUNCHPAD_FACTORY_ADDRESS=
FEE_VAULT_ADDRESS=
# Wrapped QMS (WQMS) on QMS Testnet. Must be the same address the marketplace contract was deployed with.
WRAPPED_ADDRESS=0x9AA510295aC664A3d5A3182a3eFe959DE2B12c34
OFFICIAL_COLLECTION_ADDRESS=
INDEXER_START_BLOCK=0
# Earlier marketplaces (comma separated). The Security page lets users remove their old approvals to them.
LEGACY_MARKETS=
# Set to 1 only for a moment to edit contract addresses / RPC from Admin → Network, then remove it again.
ALLOW_NETWORK_EDITS=

# ───────────────────────── Optional ───────────────────────
# Pinata JWT (needs pinning + API key admin rights) for IPFS uploads from the Create page and Studio.
# Without it creators can still launch with a pre-reveal image/link or an IPFS folder they uploaded themselves.
PINATA_JWT=
# Optional: your dedicated IPFS gateway (e.g. https://yourname.mypinata.cloud/ipfs/), tried first when loading metadata
IPFS_GATEWAY=
VERIFIED_COLLECTIONS=
# QMS blocks are about 10 s apart and the public RPC allows 50 requests a second per address.
INDEXER_POLL_MS=5000
# Blocks the indexer stays behind the newest block (QMS has no finality layer yet; 3 blocks is about 30 s).
INDEXER_CONFIRMATIONS=3
# EIP-712 domain name of the marketplace contract (set in its constructor). Default: Quantly Market.
# Leave empty unless you change the name in the contract; then set the same name here and VITE_MARKET_DOMAIN_NAME in the website.
MARKET_DOMAIN_NAME=
# Shown in sign-in messages and link previews
BRAND_NAME=Quantly
# Proxies in front of the API: 1 on Railway; 2 if Cloudflare is also in front (rate limits need the real visitor IP).
TRUST_PROXY=1
# Public API (/api/v1): limits a newly approved key gets (admins can change them per key, never above 600 a minute
# or 1,000,000 a day), and a per-IP backstop for /api/v1 (the per-key limits are the real ones).
API_FREE_PER_MINUTE=60
API_FREE_PER_DAY=10000
API_V1_IP_PER_MINUTE=2400
# IPFS upload keys handed to creators (per wallet per day, and for the whole site per day)
IPFS_KEYS_PER_WALLET=10
IPFS_KEYS_PER_DAY=300
# Memory guard for reading whole metadata folders from IPFS (MB per folder, folders at the same time)
IPFS_CAR_MAX_MB=48
IPFS_CAR_PARALLEL=2

# ───────────────────────── X (Twitter) connection for creators ─────────────────────────
# developer.x.com → your app → User authentication settings: OAuth 2.0, "Web App" (confidential client),
# permission "Read", Callback URI = X_REDIRECT_URI below, Website URL = your marketplace.
# Only @username is read (GET /2/users/me), then the token is revoked. Leave empty to turn it off.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-api.up.railway.app/api/x/callback
